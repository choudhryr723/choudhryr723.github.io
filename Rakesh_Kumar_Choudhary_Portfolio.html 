<style>
  :root, [data-theme="light"] {
    --background: 0 0% 98%;
    --foreground: 240 10% 4%;
    --card: 0 0% 100%;
    --muted: 240 5% 94%;
    --muted-foreground: 240 4% 36%;
    --border: 240 6% 85%;
    --primary: 215 80% 45%;
    --primary-foreground: 0 0% 100%;
    --elevate: rgba(0,0,0,0.03);
  }
  [data-theme="dark"] {
    --background: 0 0% 4%;
    --foreground: 0 0% 98%;
    --card: 0 0% 6%;
    --muted: 240 4% 12%;
    --muted-foreground: 240 5% 65%;
    --border: 240 4% 16%;
    --primary: 215 80% 60%;
    --primary-foreground: 0 0% 100%;
    --elevate: rgba(255,255,255,0.04);
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    font-family: 'Manrope', sans-serif;
    background: hsl(var(--background));
    color: hsl(var(--foreground));
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    selection:bg-primary;
  }
  ::selection { background: hsl(var(--primary) / 0.2); color: hsl(var(--primary)); }
  a { color: inherit; text-decoration: none; }
  .mono { font-family: 'IBM Plex Mono', monospace; }

  .wrap { width: min(100% - 48px, 72rem); margin-inline: auto; }
  .section {
    padding: 6rem 0;
    border-bottom: 1px solid hsl(var(--border));
    scroll-margin-top: 5rem;
  }
  .section-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
    margin-bottom: 1.5rem;
  }
  .section-title {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 1.25rem;
  }
  .section-lead {
    max-width: 48rem;
    color: hsl(var(--muted-foreground));
    font-size: 1.05rem;
    margin-bottom: 2rem;
  }

  /* NAV */
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: hsl(var(--background) / 0.9);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid hsl(var(--border));
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.25rem;
    gap: 1rem;
  }
  .brand {
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: -0.03em;
  }
  .brand span { color: hsl(var(--primary)); }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.35rem;
    list-style: none;
  }
  .nav-links a {
    font-size: 0.9rem;
    font-weight: 500;
    color: hsl(var(--muted-foreground));
    transition: color 0.15s;
  }
  .nav-links a:hover { color: hsl(var(--foreground)); }
  .nav-actions { display: flex; align-items: center; gap: 0.65rem; }
  .icon-btn {
    width: 2.25rem;
    height: 2.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid hsl(var(--border));
    background: transparent;
    color: hsl(var(--foreground));
    cursor: pointer;
    transition: background 0.15s;
  }
  .icon-btn:hover { background: hsl(var(--muted)); }
  .nav-toggle {
    display: none;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid hsl(var(--border));
    background: transparent;
    color: hsl(var(--foreground));
    cursor: pointer;
    font-size: 1.1rem;
  }

  /* BUTTONS */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.7rem 1.15rem;
    font-size: 0.9rem;
    font-weight: 600;
    border: 1px solid transparent;
    cursor: pointer;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
    font-family: inherit;
  }
  .btn-primary {
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
  }
  .btn-primary:hover { filter: brightness(1.08); }
  .btn-outline {
    background: transparent;
    border-color: hsl(var(--border));
    color: hsl(var(--foreground));
  }
  .btn-outline:hover { background: hsl(var(--muted)); }
  .btn-ghost {
    background: transparent;
    color: hsl(var(--muted-foreground));
    border-color: transparent;
  }
  .btn-ghost:hover {
    color: hsl(var(--foreground));
    background: hsl(var(--muted));
  }

  /* HERO */
  .hero {
    padding: 8rem 0 6rem;
    min-height: 90vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-bottom: 1px solid hsl(var(--border));
  }
  .hero-tag {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.85rem;
    color: hsl(var(--muted-foreground));
    margin-bottom: 1.25rem;
  }
  .hero h1 {
    font-size: clamp(2.6rem, 7vw, 4.75rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1.02;
    max-width: 14ch;
    margin-bottom: 1rem;
  }
  .hero-role {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    font-weight: 600;
    color: hsl(var(--primary));
    margin-bottom: 1.25rem;
  }
  .hero-intro {
    max-width: 40rem;
    font-size: 1.1rem;
    color: hsl(var(--muted-foreground));
    margin-bottom: 2rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* ABOUT GRID */
  .focus-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .chip {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    padding: 0.35rem 0.6rem;
    background: hsl(var(--muted));
    border: 1px solid hsl(var(--border));
    color: hsl(var(--muted-foreground));
  }
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: hsl(var(--border));
    border: 1px solid hsl(var(--border));
  }
  .feature {
    background: hsl(var(--card));
    padding: 1.5rem;
  }
  .feature h3 {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }
  .feature p {
    font-size: 0.9rem;
    color: hsl(var(--muted-foreground));
  }

  /* PROJECTS */
  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .project {
    display: block;
    border: 1px solid hsl(var(--border));
    background: hsl(var(--card));
    padding: 1.5rem;
    transition: background 0.15s;
  }
  .project:hover { background: hsl(var(--muted) / 0.45); }
  .project-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }
  .project h3 {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .project-link {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    color: hsl(var(--primary));
    white-space: nowrap;
  }
  .project p {
    color: hsl(var(--muted-foreground));
    font-size: 0.95rem;
    margin-bottom: 1rem;
  }
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .tag {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.72rem;
    padding: 0.25rem 0.5rem;
    background: hsl(var(--muted));
    border: 1px solid hsl(var(--border));
    color: hsl(var(--muted-foreground));
  }

  /* EXPERIENCE */
  .exp-list { display: grid; gap: 2rem; }
  .exp-item {
    position: relative;
    padding-left: 2rem;
    border-left: 1px solid hsl(var(--border));
  }
  .exp-item::before {
    content: '';
    position: absolute;
    left: -4px;
    top: 0.35rem;
    width: 7px;
    height: 7px;
    background: hsl(var(--primary));
  }
  .exp-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 0.35rem;
  }
  .exp-period {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8rem;
    color: hsl(var(--muted-foreground));
  }
  .badge {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.68rem;
    padding: 0.15rem 0.45rem;
    border: 1px solid hsl(var(--primary) / 0.35);
    color: hsl(var(--primary));
    background: hsl(var(--primary) / 0.08);
  }
  .exp-role {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .exp-org {
    color: hsl(var(--muted-foreground));
    margin-bottom: 0.65rem;
    font-size: 0.95rem;
  }
  .exp-desc {
    color: hsl(var(--muted-foreground));
    font-size: 0.95rem;
  }

  /* SKILLS */
  .skills-wrap {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .skill-group h3 {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8rem;
    border-bottom: 1px solid hsl(var(--border));
    padding-bottom: 0.5rem;
    margin-bottom: 0.85rem;
  }

  /* CONTACT */
  .contact-box {
    border: 1px solid hsl(var(--border));
    background: hsl(var(--card));
    divide: hsl(var(--border));
  }
  .contact-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid hsl(var(--border));
    transition: background 0.15s;
  }
  .contact-row:last-child { border-bottom: 0; }
  .contact-row:hover { background: hsl(var(--muted) / 0.4); }
  .contact-row span { color: hsl(var(--muted-foreground)); font-size: 0.9rem; }
  .contact-row strong { font-weight: 600; }

  footer {
    border-top: 1px solid hsl(var(--border));
    padding: 2rem 0;
    text-align: center;
    color: hsl(var(--muted-foreground));
    font-size: 0.85rem;
  }

  .fade-up {
    opacity: 0;
    transform: translateY(14px);
    animation: fadeUp 0.6s ease forwards;
  }
  .fade-up:nth-child(2) { animation-delay: 0.08s; }
  .fade-up:nth-child(3) { animation-delay: 0.16s; }
  .fade-up:nth-child(4) { animation-delay: 0.24s; }
  .fade-up:nth-child(5) { animation-delay: 0.32s; }
  @keyframes fadeUp {
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 900px) {
    .wrap { width: min(100% - 32px, 72rem); }
    .nav-toggle { display: inline-flex; align-items: center; justify-content: center; }
    .nav-links {
      display: none;
      position: absolute;
      top: 4.25rem;
      left: 0; right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 1rem 1.25rem 1.25rem;
      background: hsl(var(--background));
      border-bottom: 1px solid hsl(var(--border));
    }
    .nav-links.is-open { display: flex; }
    .nav-links a { padding: 0.75rem 0; }
    .feature-grid, .project-grid { grid-template-columns: 1fr; }
    .skills-wrap { grid-template-columns: 1fr 1fr; }
    .hero { min-height: auto; padding-top: 5.5rem; }
  }
  @media (max-width: 560px) {
    .skills-wrap { grid-template-columns: 1fr; }
    .hero-actions .btn { width: 100%; }
  }
</style>
</head>
